DB_HOST=localhost
DB_PORT=3306
DB_NAME=local_explorer
DB_USERNAME=root
DB_PASSWORD=1234

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=10

HOT_CACHE_ENABLED=true
HOT_CACHE_REDIS_ENABLED=true
HOT_CACHE_SCHEMA_VERSION=1
HOT_CACHE_L1_MAXIMUM_SIZE=2000
HOT_CACHE_L1_TTL_MILLIS=20000
HOT_CACHE_L2_TTL_MILLIS=600000
HOT_CACHE_NULL_TTL_MILLIS=30000
HOT_CACHE_STALE_TTL_MILLIS=120000
HOT_CACHE_TTL_JITTER_MILLIS=60000
HOT_CACHE_LOCK_LEASE_MILLIS=3000
HOT_CACHE_LOCK_WAIT_MILLIS=500
HOT_CACHE_LOCK_POLL_MILLIS=25
HOT_CACHE_SINGLE_FLIGHT_WAIT_MILLIS=3000
HOT_CACHE_REDIS_CIRCUIT_OPEN_MILLIS=1000
HOT_CACHE_RECOVERY_JOB_ENABLED=true
HOT_CACHE_RECOVERY_DELAY_MILLIS=2000

JWT_ADMIN_SECRET=replace-with-admin-secret
JWT_USER_SECRET=replace-with-user-secret
JWT_ADMIN_TTL=1800000
JWT_USER_TTL=1800000
AUTH_REFRESH_TTL_MILLIS=604800000
AUTH_ADMIN_COOKIE_NAME=LX_ADMIN_REFRESH
AUTH_USER_COOKIE_NAME=LX_USER_REFRESH
AUTH_COOKIE_SECURE=false
AUTH_FINGERPRINT_SECRET=replace-with-a-long-random-secret
AUTH_TRUSTED_PROXY_ENABLED=false
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_WINDOW_SECONDS=600
AUTH_LOGIN_LOCK_SECONDS=900
AUTH_REPLAY_GRACE_MILLIS=2000
AUTH_CLEANUP_BATCH_SIZE=200
AUTH_SESSION_RETENTION_DAYS=30
AUTH_SESSION_CLEANUP_DELAY_MS=3600000
# Encrypts personally identifiable export filters stored in query snapshots.
EXPORT_SNAPSHOT_SECRET=replace-with-a-long-random-secret

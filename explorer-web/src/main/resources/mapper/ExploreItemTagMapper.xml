<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.localexplorer.mapper.ExploreItemTagMapper">

    <insert id="insertBatch">
        insert into explore_item_tag (item_id, name, value) VALUES
        <foreach collection="tags" item = "df" separator=",">
            (#{df.itemId},#{df.name},#{df.value})
        </foreach>
    </insert>
    <delete id="deleteByExploreItemIds">
        delete from explore_item_tag where item_id in
        <foreach collection="itemIds" item="itemId" open="(" close=")" separator=",">
            #{itemId}
        </foreach>
    </delete>
</mapper>

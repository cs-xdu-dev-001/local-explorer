<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.localexplorer.mapper.ExplorePackageItemMapper">


    <select id="getPackageIdsByExploreItemIds" resultType="java.lang.Long">
        select package_id from explore_package_item where item_id in
        <foreach collection="itemIds" item="itemId" separator="," open="(" close=")">
            #{itemId}
        </foreach>
    </select>


    <insert id="insertBatch" parameterType="list">
        insert into explore_package_item
        (package_id,item_id,name,price,copies)
        values
        <foreach collection="packageItems" item="packageItem" separator=",">
            (#{packageItem.packageId},#{packageItem.itemId},#{packageItem.name},#{packageItem.price},#{packageItem.copies})
        </foreach>
    </insert>


</mapper>
